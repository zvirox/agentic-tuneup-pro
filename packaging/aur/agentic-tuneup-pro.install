post_install() {
    # Reload D-Bus and systemd
    if systemctl is-active dbus >/dev/null 2>&1; then
        systemctl reload dbus 2>/dev/null || true
        systemctl daemon-reload 2>/dev/null || true
    fi

    # Update desktop and icon caches
    update-desktop-database -q /usr/share/applications 2>/dev/null || true
    gtk-update-icon-cache -q -t -f /usr/share/icons/hicolor 2>/dev/null || true

    echo "==> Agentic Tuneup Pro installed successfully."
    echo "==> To enable the privileged helper service:"
    echo "    sudo systemctl enable --now atpd-helper.service"
}

post_upgrade() {
    post_install
}

pre_remove() {
    if systemctl is-active atpd-helper.service >/dev/null 2>&1; then
        systemctl stop atpd-helper.service 2>/dev/null || true
        systemctl disable atpd-helper.service 2>/dev/null || true
    fi
}

post_remove() {
    if systemctl is-active dbus >/dev/null 2>&1; then
        systemctl daemon-reload 2>/dev/null || true
        systemctl reload dbus 2>/dev/null || true
    fi
    update-desktop-database -q /usr/share/applications 2>/dev/null || true
    gtk-update-icon-cache -q -t -f /usr/share/icons/hicolor 2>/dev/null || true
}
