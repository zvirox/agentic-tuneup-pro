#!/usr/bin/env bash
# ==============================================================================
# Agentic Tuneup Pro — AppImage Runtime Entrypoint (AppRun)
# ==============================================================================

set -e

SELF=$(readlink -f "$0")
APPDIR=$(dirname "$SELF")

export PATH="${APPDIR}/usr/bin:${PATH}"
export LD_LIBRARY_PATH="${APPDIR}/usr/lib:${APPDIR}/usr/lib64:${LD_LIBRARY_PATH:-}"
export XDG_DATA_DIRS="${APPDIR}/usr/share:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"

# Ensure WebKitGTK environment variables for Linux Wayland & X11 compatibility
if [ -z "${WEBKIT_DISABLE_COMPOSITING_MODE:-}" ]; then
    # Keep hardware acceleration enabled unless specified
    export WEBKIT_DISABLE_COMPOSITING_MODE=0
fi

exec "${APPDIR}/usr/bin/agentic-tuneup-pro" "$@"
