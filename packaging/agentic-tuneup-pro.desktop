[Desktop Entry]
Name=Agentic Tuneup Pro
GenericName=System Optimizer and Cleaner
Comment=Sovereign AI-orchestrated Linux system cleaner, package manager, and performance suite
Exec=agentic-tuneup-pro %U
Icon=in.zvirox.agentictuneuppro
Terminal=false
Type=Application
Categories=System;Utility;Filesystem;Settings;
Keywords=system;cleaner;optimizer;tuneup;disk;memory;package;flatpak;starship;mcp;
StartupNotify=true
StartupWMClass=agentic-tuneup-pro
MimeType=x-scheme-handler/atp;
Actions=Clean;Diagnostics;

[Desktop Action Clean]
Name=Scan and Clean Junk
Exec=agentic-tuneup-pro --page clean
Icon=in.zvirox.agentictuneuppro

[Desktop Action Diagnostics]
Name=System Health & Diagnostics
Exec=agentic-tuneup-pro --page dash
Icon=in.zvirox.agentictuneuppro
