{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Agentic Tuneup Pro",
  "version": "0.1.0",
  "identifier": "in.zvirox.agentictuneuppro",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost https: blob: data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:;",
      "assetProtocol": {
        "enable": true
      }
    },
    "windows": [
      {
        "title": "Agentic Tuneup Pro",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "decorations": false,
        "transparent": false,
        "shadow": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "deb", "rpm"],
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "license": "Apache-2.0",
    "licenseFile": "../../LICENSE",
    "shortDescription": "Agentic PC tuneup and system cleaning app for Linux",
    "longDescription": "Agentic Tuneup Pro is a sovereign, agentic system cleaner, package manager, and performance suite for Linux.",
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0 | libwebkit2gtk-4.0-37",
          "libgtk-3-0",
          "libayatana-appindicator3-1 | libappindicator3-1"
        ],
        "files": {
          "/usr/share/polkit-1/actions/in.zvirox.agentic_tuneup.policy": "../../packaging/in.zvirox.agentic_tuneup.policy",
          "/usr/share/dbus-1/system.d/in.zvirox.AgenticTuneupHelper.conf": "../../packaging/in.zvirox.AgenticTuneupHelper.conf",
          "/usr/lib/systemd/system/atpd-helper.service": "../../packaging/atpd-helper.service"
        }
      },
      "rpm": {
        "depends": [
          "webkit2gtk4.1",
          "gtk3",
          "libappindicator-gtk3"
        ],
        "files": {
          "/usr/share/polkit-1/actions/in.zvirox.agentic_tuneup.policy": "../../packaging/in.zvirox.agentic_tuneup.policy",
          "/usr/share/dbus-1/system.d/in.zvirox.AgenticTuneupHelper.conf": "../../packaging/in.zvirox.AgenticTuneupHelper.conf",
          "/usr/lib/systemd/system/atpd-helper.service": "../../packaging/atpd-helper.service"
        }
      }
    }
  }
}
